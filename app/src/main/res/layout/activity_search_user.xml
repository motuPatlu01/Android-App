<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search User"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter User Email"
        app:boxStrokeColor="#FFD700"
        app:hintTextColor="#FFD700">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnDoSearch"
        style="@style/GlowingGoldenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Search" />

    <!-- Result Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearchResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1E1E1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A2A2A">
                <ImageView
                    android:id="@+id/ivSearchProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvSearchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvSearchEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#CCCCCC"
                android:textSize="14sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginVertical="16dp"/>

            <TextView
                android:id="@+id/tvSearchProfession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profession: --"
                android:textColor="#FFFFFF"
                android:layout_gravity="start"/>

            <TextView
                android:id="@+id/tvSearchHobby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hobby: --"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_gravity="start"/>

            <TextView
                android:id="@+id/tvSearchAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Age: --"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_gravity="start"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
